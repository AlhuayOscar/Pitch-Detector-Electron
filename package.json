{
  "name": "pitch-detector-desktop",
  "version": "1.4.0-automatized.1",
  "private": true,
  "description": "Detector de notas y afinación en tiempo real, sin conexión",
  "author": "Pitch Detector contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "worklet": "tsc -p tsconfig.worklet.json",
    "dev": "npm run worklet && vite",
    "build": "npm run worklet && vite build",
    "postbuild": "node scripts/write-third-party-notices.mjs",
    "build:pages": "npm run build -- --base=/pitch-detector/",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@tensorflow/tfjs": "4.22.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "lucide-solid": "^0.487.0",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.6",
    "vite-plugin-solid": "^2.11.6"
  }
}
